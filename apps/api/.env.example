DB_ENVIRONMENT=dev

# Neon → dev → Connect.
DATABASE_URL="postgresql://sadhana_dev:REPLACE@ep-green-meadow-aglyz4ha-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
MIGRATION_DATABASE_URL="postgresql://sadhana_dev:REPLACE@ep-green-meadow-aglyz4ha.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# JWT: восстановить из менеджера паролей или сгенерировать два независимых ключа:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))' — отдельно для каждого.
JWT_SECRET="replace-with-separate-dev-jwt-secret"
JWT_REFRESH_SECRET="replace-with-separate-dev-refresh-secret"

# Общий пароль тестовых профилей для seed/reseed/reset/rehearse.
# Смена env не обновляет пароли существующих аккаунтов; из bcrypt-хешей пароль не восстановить.
DEV_FIXTURE_PASSWORD=""
