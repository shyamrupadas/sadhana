{
  "name": "sadhana",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@sadhana/api",
    "build:web": "turbo run build --filter=@sadhana/web",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@sadhana/api...",
    "dev:web": "turbo run dev --filter=@sadhana/web...",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @sadhana/web test:e2e",
    "typecheck": "turbo run typecheck",
    "db:status": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts status",
    "db:migrate": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts migrate",
    "db:dev-seed": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts seed",
    "db:dev-reseed": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts reseed",
    "db:dev-reset": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts reset",
    "db:rehearse": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts rehearse",
    "db:test": "pnpm --filter @sadhana/api exec tsx src/db/dev-database.ts test"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
