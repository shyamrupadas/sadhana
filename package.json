{
  "name": "sadhana",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@sadhana/web",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@sadhana/web...",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
