      "DailyEntry": {
        "type": "object",
        "required": [
          "id",
          "date",
          "sleep",
          "habits"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "sleep": {
            "$ref": "#/components/schemas/SleepData"
          },
          "habits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HabitCheck"
            }
          }
        }
      },
      "DailyHabitMarkInput": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "boolean"
          }
