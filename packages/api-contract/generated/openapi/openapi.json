      "HabitCheck": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "boolean"
          }
        }
      },
      "HabitCreateInput": {
        "type": "object",
        "required": [
          "label",
          "creationDate"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "creationDate": {
            "$ref": "#/components/schemas/CalendarDate"
          }
        }
      },
      "HabitDayState": {
        "type": "string",
        "enum": [
          "done",
          "failed",
          "unmarked",
          "notApplicable"
        ]
      },
      "HabitDefinition": {
        "type": "object",
        "required": [
          "key",
          "label",
          "createdAt",
          "startDate",
          "archived"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "nullable": true,
            "description": "Original local creation timestamp; unknown legacy timestamps remain null."
          },
          "startDate": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "HabitDeletionSummary": {
        "type": "object",
        "required": [
          "key",
          "label",
          "markCount"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "markCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HabitInput": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "HabitStatisticsValue": {
        "type": "object",
        "required": [
          "habitId",
          "successRate",
          "completeness",
          "trueCount",
          "falseCount",
          "eligibleDayCount"
        ],
        "properties": {
          "habitId": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/HabitDayState"
          },
          "successRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "completeness": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "trueCount": {
            "type": "integer",
            "format": "int32"
          },
          "falseCount": {
            "type": "integer",
            "format": "int32"
          },
          "eligibleDayCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        }
      },
      "SleepData": {
        "type": "object",
        "required": [
          "bedtime",
          "wakeTime",
          "napDuration",
          "duration"
        ],
        "properties": {
          "bedtime": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
          },
          "wakeTime": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
          },
          "napDuration": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "minimum": 0
          },
          "duration": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "minimum": 0,
            "description": "Computed from the previous day's bedtime, this day's wake time, and nap duration. Null when either time is absent."
          }
        }
      },
      "SleepDataInput": {
        "type": "object",
        "required": [
          "napDuration"
        ],
        "properties": {
          "bedtime": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
          },
          "wakeTime": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
          },
          "napDuration": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "minimum": 0,
            "description": "Original nonnegative minutes; absent nap is null."
          }
        }
      },
      "SleepMetric": {
        "type": "object",
        "required": [
          "value",
          "sum",
          "count"
        ],
        "properties": {
          "value": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "sum": {
            "type": "number",
            "format": "double"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SleepStatisticsColumn": {
        "type": "object",
        "required": [
          "from",
          "toExclusive",
          "habits",
          "bedtime",
          "wakeTime",
          "nap",
          "duration"
        ],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "toExclusive": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "source": {
            "$ref": "#/components/schemas/SleepData"
          },
          "habits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HabitStatisticsValue"
            }
          },
          "bedtime": {
            "$ref": "#/components/schemas/SleepMetric"
          },
          "wakeTime": {
            "$ref": "#/components/schemas/SleepMetric"
          },
          "nap": {
            "$ref": "#/components/schemas/SleepMetric"
          },
          "duration": {
            "$ref": "#/components/schemas/SleepMetric"
          }
        }
      },
      "StatisticsData": {
        "type": "object",
        "required": [
          "granularity",
          "from",
          "toExclusive",
          "asOfDate",
          "historyFrom",
          "habits",
          "columns"
        ],
        "properties": {
          "granularity": {
            "$ref": "#/components/schemas/StatisticsGranularity"
          },
          "from": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "toExclusive": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "asOfDate": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "historyFrom": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "habits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HabitDefinition"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SleepStatisticsColumn"
            }
          }
        }
      },
      "StatisticsGranularity": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year"
        ]
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  }
}
