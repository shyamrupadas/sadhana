      "put": {
        "operationId": "SleepRecords_putSleepRecord",
        "description": "Creates or replaces sleep data. Duration uses the previous day's bedtime and this day's wake time.",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CalendarDate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyEntry"
