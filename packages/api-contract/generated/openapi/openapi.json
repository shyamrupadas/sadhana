    "/sleep-records/{date}": {
      "get": {
        "operationId": "SleepRecords_getSleepRecord",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CalendarDate"
            }
