{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/api-contract/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json",
      "/.github/workflows/contract.yml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "preDeployCommand": ["node dist/db/migrate.js"]
  }
}
